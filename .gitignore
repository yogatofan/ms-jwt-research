# =============================================================================
# .gitignore for ms-jwt-research
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json.bak

# ── Environment Variables (Secret keys & credentials) ────────────────────────
.env
.env.*
*.env
**/.env
**/.env.*

# ── Logs & Debugging ─────────────────────────────────────────────────────────
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
load-testing/results/**/logs/

# ── Python & Virtual Environments ────────────────────────────────────────────
venv/
**/venv/
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# ── OS & Editor Artifacts ────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/

# ── draw.io Temporary & Backup Files ─────────────────────────────────────────
.$*.bkp
*.drawio.bkp
.*.drawio.bkp

# ── Load Testing Data & Large Dumps ──────────────────────────────────────────
# Abaikan file dump raw k6 yang berukuran sangat besar (bisa >10 GB)
load-testing/results/result-*.json
load-testing/results/**/result-*.json
load-testing/results/*.json

# Pengecualian: Tetap simpan hasil summary dan data statistik
!load-testing/results/**/summary.json
!load-testing/results/*.csv
!load-testing/results/*.md

# ── Local Assistant & Graphify Metadata ──────────────────────────────────────
.agents/
graphify-out/

# ── Local Review Notes ───────────────────────────────────────────────────────
notes/
notes.md